{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
      "defaultMode": "plan",
      "disableBypassPermissionsMode": "disable",
      "disableAutoMode": "disable",
      "allow": [
        "Bash(uv sync)",
        "Bash(uv sync *)",
        "Bash(uv run pytest *)",
        "Bash(uv run --directory api pytest *)",
        "Bash(uv run --directory llmkit pytest *)",
        "Bash(uv run --directory api ruff *)",
        "Bash(uv run --directory api pyright *)",
        "Bash(uv run --directory llmkit ruff *)",
        "Bash(uv run --directory llmkit pyright *)",
        "Bash(uv run ruff format *)",
        "Bash(uv run ruff check *)",
        "Bash(uv run pyright *)",
        "Bash(uv run python -m app.load_world)",
        "Bash(uv run --directory api python -m app.load_world)",
        "Bash(docker compose up -d db)",
        "Bash(docker compose ps *)",
        "Bash(git status *)",
        "Bash(git diff *)",
        "Bash(git log *)",
        "Bash(git show *)",
        "Bash(git branch --show-current)",
        "Bash(git switch -c *)",
        "Bash(git add *)",
        "Bash(git commit *)",
        "Bash(pre-commit run *)",
        "Bash(gh pr view *)",
        "Bash(gh pr checks *)",
        "Bash(gh run view *)"
      ],
      "ask": [
        "Bash(git push *)",
        "Bash(gh pr create *)",
        "Bash(uv add *)",
        "Bash(uv remove *)",
        "Bash(uv lock *)",
        "Bash(uv run uvicorn *)",
        "Bash(npm install *)",
        "Bash(curl *)",
        "Bash(wget *)",
        "Bash(docker compose exec *)",
        "Bash(psql *)",
        "Edit(**/pyproject.toml)"
      ],
      "deny": [
        "Read(.env)",
        "Read(.env.*)",
        "Read(!.env.example)",
        "Read(**/*.pem)",
        "Read(**/*.key)",
        "Read(~/.aws/**)",
        "Read(~/.ssh/**)",
        "Read(~/.config/gh/**)",
        "Edit(/data/world.json)",
        "Edit(**/uv.lock)",
        "Bash(sudo *)",
        "Bash(rm -rf *)",
        "Bash(rm -fr *)",
        "Bash(git push --force *)",
        "Bash(git push -f *)",
        "Bash(git push --force-with-lease *)",
        "Bash(git reset --hard *)",
        "Bash(git clean *)",
        "Bash(git branch -D *)",
        "Bash(git commit --no-verify *)",
        "Bash(git commit -n *)",
        "Bash(git -c core.hooksPath*)",
        "Bash(git config core.hooksPath*)",
        "Bash(SKIP=*)",
        "Bash(PRE_COMMIT_ALLOW_NO_CONFIG=*)",
        "Bash(pre-commit uninstall*)",
        "Bash(docker compose down -v *)",
        "Bash(docker volume rm *)",
        "Bash(printenv *)",
        "Bash(gh pr merge *)",
        "Bash(gh repo delete *)"
      ]
    },
    "sandbox": {
      "enabled": true,
      "autoAllowBashIfSandboxed": false,
      "allowUnsandboxedCommands": false,
      "failIfUnavailable": true,
      "excludedCommands": [
        "docker compose up -d db",
        "docker compose ps *",
        "docker compose exec *",
        "uv run pytest *",
        "uv run --directory api pytest *",
        "uv run python -m app.load_world",
        "uv run --directory api python -m app.load_world",
        "uv run uvicorn *",
        "gh pr create *",
        "gh pr view *",
        "gh pr checks *",
        "gh run view *"
      ],
      "filesystem": {
        "allowWrite": [
          "~/.cache/uv",
          "~/.cache/pyright-python",
          "~/.cache/pre-commit"
        ]
      },
      "network": {
        "allowedDomains": [
          "pypi.org",
          "files.pythonhosted.org",
          "registry.npmjs.org",
          "nodejs.org"
        ]
      },
      "credentials": {
        "files": [
          {
            "path": "./.env",
            "mode": "deny"
          },
          {
            "path": "~/.aws",
            "mode": "deny"
          },
          {
            "path": "~/.ssh",
            "mode": "deny"
          },
          {
            "path": "~/.config/gh",
            "mode": "deny"
          }
        ],
        "envVars": [
          {
            "name": "ANTHROPIC_API_KEY",
            "mode": "deny"
          },
          {
            "name": "LLMKIT_PROVIDER_API_KEY",
            "mode": "deny"
          },
          {
            "name": "GITHUB_TOKEN",
            "mode": "deny"
          },
          {
            "name": "GH_TOKEN",
            "mode": "deny"
          },
          {
            "name": "AWS_SECRET_ACCESS_KEY",
            "mode": "deny"
          },
          {
            "name": "AWS_SESSION_TOKEN",
            "mode": "deny"
          }
        ]
      }
    },
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Edit|Write",
          "hooks": [
            {
              "type": "command",
              "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-files.sh",
              "args": [],
              "timeout": 10,
              "onFailure": "block",
              "statusMessage": "Checking the file is safe to edit"
            }
          ]
        },
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.sh",
              "args": [],
              "timeout": 10,
              "onFailure": "block",
              "statusMessage": "Checking the command"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Edit|Write",
          "hooks": [
            {
              "type": "command",
              "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format-python.sh",
              "args": [],
              "timeout": 30,
              "statusMessage": "ruff format and fix"
            }
          ]
        }
      ]
    }
  }
  